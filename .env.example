# Copy to .env and fill in from the web app's Supabase project settings.
# EXPO_PUBLIC_ vars are inlined into the client bundle at build time — safe
# for the anon key (same trust boundary as the web app's VITE_ vars), never
# put a service-role key behind this prefix.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PostHog project token (public by design) and host. The web app used the EU
# cloud. Leave the key empty to send nothing; Settings then hides the toggle.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
